# Public access to the HAI stack (spec: .claude/specs/hai-public-access-spec.md).
#
# Copy to .env on the SERVER only (.env is gitignored), then re-run
# scripts/setup_interactiveai.sh and `docker compose up -d --build`.
# Without HAI_PUBLIC_HOST everything stays on localhost, as on a laptop.
#
# Plain HTTP; reachable from the TU Delft network or VPN only (ICT firewall).
# With this on, InteractiveAI login works only at the public URL, not at
# http://localhost:3200.

# Hostname participants type. Unset or blank = public access off.
# HAI_PUBLIC_HOST=aieffect-dutch01.ewi.tudelft.nl

# Server port for the InteractiveAI GUI (added next to 3200). Default 443.
# HAI_FRONTEND_PUBLIC_PORT=443

# Server port for the PowerGrid simulator UI (added next to 5122). Default 8443.
# HAI_SIMULATOR_PUBLIC_PORT=8443
